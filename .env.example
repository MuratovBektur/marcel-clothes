DB_USER = YOUR_DB_USER
DB_PASSWORD = YOUR_DB_PASSWORD
DB_NAME = YOUR_DB_NAME
DB_PORT = YOUR_DB_PORT
DB_HOST = YOUR_DB_HOST # используй host.docker.internal если бд запущен на хосте

TELEGRAM_BOT_TOKEN = YOUR_TELEGRAM_BOT_TOKEN

# ─── Необязательно: свой сервер telegram-bot-api вместо облачного api.telegram.org ───
# Зачем: облачный Bot API умеет скачивать/загружать файлы не больше 20 МБ — жёсткий
# лимит самого Telegram, кодом это не обойти. Свой сервер telegram-bot-api поднимает
# этот лимит до 2000 МБ (см. сервис "telegram-bot-api" в docker-compose.local.yml,
# отключён по умолчанию через profiles — включить: `docker compose --profile telegram-bot-api up -d`).
# TELEGRAM_API_ID / TELEGRAM_API_HASH получаются на https://my.telegram.org/apps
# (нужен личный Telegram-аккаунт, подтверждение по номеру телефона) — сгенерировать
# их можно только вручную, это не то же самое, что TELEGRAM_BOT_TOKEN.
TELEGRAM_API_ID = YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH = YOUR_TELEGRAM_API_HASH
# Адрес своего сервера telegram-bot-api. Если не задан — используется облачный
# api.telegram.org (лимит 20 МБ). После включения сервиса из docker-compose:
TELEGRAM_BOT_API_ROOT = http://telegram-bot-api:8081

# Список номеров телефонов с доступом к боту (через запятую, любой формат)
ALLOWED_PHONES = +79001234567,+79009876543

# Публичный домен этого сайта — используется для построения ссылок на фото товаров
PUBLIC_URL = https://marcel.kg

# Синхронизация товаров с глобальным маркетом (showroom / optom.store)
SHOWROOM_API_URL = https://optom.store/api/bot-products
SHOWROOM_API_KEY = YOUR_SHOWROOM_API_KEY

# Публикация в Instagram и на Facebook-странице через Meta Graph API
# (один системный пользователь Meta Business Suite на оба канала)
# META_ACCESS_TOKEN — бессрочный токен системного пользователя с правами
# instagram_content_publish и pages_manage_posts
META_ACCESS_TOKEN = YOUR_META_ACCESS_TOKEN
# Версия Graph API, необязательно (по умолчанию v21.0)
META_GRAPH_API_VERSION = v21.0

# IG_BUSINESS_ACCOUNT_ID — ID Instagram-аккаунта (Instagram Business Account ID, не username)
IG_BUSINESS_ACCOUNT_ID = YOUR_IG_BUSINESS_ACCOUNT_ID
# FB_PAGE_ID — ID Facebook-страницы (не Business Manager и не Instagram-аккаунта)
FB_PAGE_ID = YOUR_FB_PAGE_ID